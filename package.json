{
  "name": "perp-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "node server/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
