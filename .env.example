# Copy to .env and fill in. Never commit .env.

# Hyperliquid: public, read by wallet address (no key). Sub-accounts are picked up automatically.
HL_ADDRESS=0x567338a1bDB6D7cE2AacCa25b69fc1a5c82708cA

# API server
PORT=8787
HOST=127.0.0.1        # keep local; if you expose it, set DASH_USER/DASH_PASS below

# Optional basic auth for the whole dashboard + API
# DASH_USER=
# DASH_PASS=

# Extended: read-only API key (Settings → API management). One key = one sub-account;
# for several accounts, comma-separate the keys — they are merged into one "Extended" in the UI.
# EXTENDED_API_KEY=

# Perpl: API key with the "read" scope only (https://app.perpl.xyz/apikeys)
# PERPL_API_KEY=           # the X-API-Key token
# PERPL_API_KEY_SECRET=    # hex Ed25519 private key; it signs every request and never leaves this server

# Next adapter (Plan §3)
# ARCUS_ADDRESS=
